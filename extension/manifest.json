
{
  "manifest_version": 3,
  "name": "Learn with My Platform",
  "version": "1.0.0",
  "description": "Capture useful web knowledge into your AI Learning Assistant and reuse its existing AI, quizzes and flashcards.",
  "action": {
    "default_title": "Learn with My Platform",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "https://intellipath-project-2.onrender.com/*",
    "https://intelli-path-project.vercel.app/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/selection.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
